def decrypt_monoalphabetic(ciphertext, key):
    alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    key_map = {k: a for k, a in zip(key.upper(), alphabet)}
    decrypted = ''
    
    for char in ciphertext:
        if char.isalpha():
            is_upper = char.isupper()
            decrypted_char = key_map[char.upper()]
            decrypted += decrypted_char if is_upper else decrypted_char.lower()
        else:
            decrypted += char
    return decrypted

# Example usage
cipher = "Zol abyyl zljyla!"
key = "QWERTYUIOPASDFGHJKLZXCVBNM"  # Example key
print(decrypt_monoalphabetic(cipher, key))
